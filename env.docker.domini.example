# Copia a .env a l'arrel del monorepo (obligatori: docker-compose.yml el carrega amb env_file): cp env.docker.domini.example .env
# Exemple per desplegament amb dominis.
# "EXPLOTACIO_PREFIX" és la part que canvia a cada projecte (ex: demo-exploitation).
# Nota: Docker Compose no sempre expandeix variables dins del mateix .env.
# Per això, cal FRONTEND_DOMAIN i BACKEND_DOMAIN posar completament el domini

EXPLOTACIO_PREFIX=demo-exploitation

POSTGRES_DB=avsis_customers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_PORT=5432

REDIS_PORT=6379

SECRET_KEY=change-me-use-a-long-random-string
DEBUG=False

# Dominis públics
FRONTEND_DOMAIN=demo-exploitation.customers.example.com
BACKEND_DOMAIN=demo-exploitation.api-customers.example.com

# Hostnames per Django (inclou backend intern per al healthcheck de docker-compose)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,demo-exploitation.customers.example.com,demo-exploitation.api-customers.example.com

CSRF_TRUSTED_ORIGINS=https://demo-exploitation.api-customers.example.com

BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL de l'API tal com la veu el navegador
NUXT_PUBLIC_API_HOST=https://demo-exploitation.api-customers.example.com

# URL base per servir media del backend
DOMAIN_MEDIA=https://demo-exploitation.api-customers.example.com

# Frontend (build i execució): idioma per defecte i etiqueta d'entorn
LANGUAGE=ca
ENV=test
