# Copia a .env a l'arrel del monorepo (obligatori: docker-compose.yml el carrega amb env_file): cp env.docker.example .env
# Variables usades per docker compose

POSTGRES_DB=avsis_customers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# Obligatòria amb DEBUG=False i no pot ser la d'aquest exemple. Genera-la amb:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Adreça de l'aplicació per a l'enllaç del correu de recuperació de contrasenya.
# Si és buida, es fa servir l'origen de la petició si és a CSRF_TRUSTED_ORIGINS.
# FRONTEND_URL=http://localhost:3000

# Comptes que, a més de `customers`, poden ser superusuaris (gestionen usuaris i grups).
# Noms d'usuari separats per comes. Només el compte `customers` els dona el rol des de la fitxa.
# EXTRA_SUPERUSER_USERNAMES=

BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL de l'API tal com la veu el navegador (no useu http://backend:8000)
NUXT_PUBLIC_API_HOST=http://localhost:8000

DOMAIN_MEDIA=http://localhost:8000

# Contrasenya SMTP (Django: EMAIL_HOST_PASSWORD), passada al contenidor backend
EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=msgraphbackend.MSGraphBackend
# MSGRAPH_TENANT_ID=
# MSGRAPH_CLIENT_ID=
# MSGRAPH_CLIENT_SECRET=
# MSGRAPH_USER_ID=

# Frontend (build i execució): idioma per defecte i etiqueta d'entorn
LANGUAGE=ca
ENV=test

# GMAO: només als clients que el fan servir. Engega el servei gmao-consumer.
# COMPOSE_PROFILES=gmao

# Versió de les imatges de GitHub (ghcr.io) que es fa servir. Buit = es construeix aquí (`local-<stack>`).
# CUSTOMERS_VERSION=v1.135.00
