# Copia a .env a l'arrel del monorepo (obligatori: docker-compose.yml el carrega amb env_file): cp env.docker.example .env
# Variables usades per docker compose

POSTGRES_DB=avsis_customers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL de l'API tal com la veu el navegador (no useu http://backend:8000)
NUXT_PUBLIC_API_HOST=http://localhost:8000

DOMAIN_MEDIA=http://localhost:8000

# Contrasenya SMTP (Django: EMAIL_HOST_PASSWORD), passada al contenidor backend
EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=msgraphbackend.MSGraphBackend
# MSGRAPH_TENANT_ID=
# MSGRAPH_CLIENT_ID=
# MSGRAPH_CLIENT_SECRET=
# MSGRAPH_USER_ID=

# Frontend (build i execució): idioma per defecte i etiqueta d'entorn
LANGUAGE=ca
ENV=test
