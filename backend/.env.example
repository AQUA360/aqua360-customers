SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SETTINGS=dev

DATABASE_NAME=avsis_customers
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Celery (Redis). En Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

DOMAIN_MEDIA=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=msgraphbackend.MSGraphBackend
# MSGRAPH_TENANT_ID=your-tenant-id
# MSGRAPH_CLIENT_ID=your-client-id
# MSGRAPH_CLIENT_SECRET=your-client-secret
# MSGRAPH_USER_ID=
EMAIL_HOST_PASSWORD=your-smtp-password

DATABASE_NAME_TEST=avsis_customers_test

FTP_HOST=ftp.example.com
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password

DOCUMENT_MANAGER_CONTRACT=hdd
DOCUMENT_MANAGER_BILLING=hdd
DOCUMENT_MANAGER_TEMPLATES=hdd
DOCUMENT_MANAGER_ORDER=hdd
DOCUMENT_MANAGER_FRAUD=hdd
DOCUMENT_MANAGER_STATISTICS=hdd
DOCUMENT_MANAGER_COMMUNICATION=hdd

# Signed PDFs (optional)
PFX_PASS=your-certificate-password
PFX_PATH=path/to/certificate.p12

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_REGION=your-region

# Alfresco (optional)
ALFRESCO_BASE_URL=https://alfresco.example.com
ALFRESCO_USERNAME=your-username
ALFRESCO_PASSWORD=your-password

# Azure (optional)
AZURE_ACCOUNT_URL=https://yourstorage.blob.core.windows.net/
AZURE_ACCOUNT_NAME=your-storage-name
AZURE_ACCOUNT_KEY=your-storage-key
AZURE_CONTAINER_NAME=your-container-name

# invoice language = {'ca', 'es', 'en'} ov app related
INVOICE_LANGUAGE=ca
LANGUAGE_CODE=ca

OV_USER_USERNAME=ovuser
OV_USER_PASSWORD=change-me
OV_USER_EMAIL=ov@example.com

# RabbitMQ/GMAO External Integration
RABBITMQ_ENABLED=False
RABBITMQ_URL=amqp://user:password@localhost:5672//
RABBIT_IN_QUEUE=gmao-events
RABBIT_OUT_QUEUE=crm-events
GMAO_HOST=http://localhost:8000
