# Obligatòria amb DEBUG=False i no pot ser la d'aquest exemple. Genera-la amb:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

SETTINGS=dev

DATABASE_NAME=avsis_customers
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Informes personalitzats: rol de PostgreSQL de només lectura (crear-lo amb
# `python manage.py setup_custom_reports_role`). Sense aquest rol no s'executen informes.
#CUSTOM_REPORTS_DATABASE_USER=aqua360_reports
#CUSTOM_REPORTS_DATABASE_PASSWORD=change-me

# Celery (Redis). En Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Memòria (KB) a partir de la qual es recicla un procés del worker en acabar la tasca (2 GB)
#CELERY_WORKER_MAX_MEMORY_PER_CHILD=2097152

DOMAIN_MEDIA=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=msgraphbackend.MSGraphBackend
# MSGRAPH_TENANT_ID=your-tenant-id
# MSGRAPH_CLIENT_ID=your-client-id
# MSGRAPH_CLIENT_SECRET=your-client-secret
# MSGRAPH_USER_ID=
EMAIL_HOST_PASSWORD=your-smtp-password

DATABASE_NAME_TEST=avsis_customers_test

SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=your-sftp-user
SFTP_PASSWORD=your-sftp-password
SFTP_KEY_FILE=
SFTP_KNOWN_HOSTS=/path/to/known_hosts

DOCUMENT_MANAGER_CONTRACT=hdd
DOCUMENT_MANAGER_BILLING=hdd
DOCUMENT_MANAGER_TEMPLATES=hdd
DOCUMENT_MANAGER_ORDER=hdd
DOCUMENT_MANAGER_FRAUD=hdd
DOCUMENT_MANAGER_STATISTICS=hdd
DOCUMENT_MANAGER_COMMUNICATION=hdd

# Signed PDFs (optional)
PFX_PASS=your-certificate-password
PFX_PATH=path/to/certificate.p12

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_REGION=your-region

# Alfresco (optional)
ALFRESCO_BASE_URL=https://alfresco.example.com
ALFRESCO_USERNAME=your-username
ALFRESCO_PASSWORD=your-password

# Azure (optional)
AZURE_ACCOUNT_URL=https://yourstorage.blob.core.windows.net/
AZURE_ACCOUNT_NAME=your-storage-name
AZURE_ACCOUNT_KEY=your-storage-key
AZURE_CONTAINER_NAME=your-container-name

# invoice language = {'ca', 'es', 'en'} ov app related
INVOICE_LANGUAGE=ca
LANGUAGE_CODE=ca

OV_USER_USERNAME=ovuser
OV_USER_PASSWORD=change-me
OV_USER_EMAIL=ov@example.com

# Oficina virtual: sincronització diària dels contractes amb l'OV activa
OV_API_BASE_URL=
OV_API_KEY=
OV_ACTIVE_CONTRACTS_ENDPOINT=/api/linked-contracts/
OV_SYNC_ENABLED=False
OV_SYNC_HOUR=4
OV_SYNC_MINUTE=0

# RabbitMQ/GMAO External Integration
RABBITMQ_ENABLED=False
# Obligatòria si RABBITMQ_ENABLED=True. Amb DEBUG=False no s'accepten guest/guest ni
# aquestes credencials d'exemple: cal un usuari propi de la instal·lació.
RABBITMQ_URL=amqp://user:password@localhost:5672//
RABBIT_IN_QUEUE=gmao-events
RABBIT_OUT_QUEUE=crm-events
GMAO_HOST=http://localhost:8000

# Plugins de client, fora d'aquest repositori.
# El servidor segueix amb la imatge pública de CUSTOMERS_VERSION.
# PLUGINS és la llista d'apps. PLUGIN_IMAGE_<nom> és el registre, sense etiqueta.
# No es fa servir BACKEND_IMAGE.
#PLUGINS=
#PLUGIN_IMAGE_exemple=ghcr.io/exemple/plugin-exemple

# Odoo. fastapi = connector aqua360_connector. json2 = API nativa Enterprise SaaS.
ODOO_TRANSPORT=fastapi
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_TIMEOUT=30
ODOO_PUSH_ENABLED=False
ODOO_PUSH_INVOICES=True
ODOO_PUSH_PAYMENTS=True
ODOO_INBOUND_BEARER_TOKEN=
